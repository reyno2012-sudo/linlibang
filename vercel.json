{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/mobile.html" },
    { "source": "/api/:path*", "destination": "/api/index?path=:path*" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
